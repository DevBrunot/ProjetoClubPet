<!DOCTYPE html>
<html>
<head>
  <title>Acompanhamento do Serviço</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; }
    .tracking-card { max-width: 500px; margin: auto; border: 1px solid #ccc; border-radius: 8px; padding: 24px; box-shadow: 0 2px 8px #eee; }
    .tracking-card h2 { margin-top: 0; }
    .status { font-weight: bold; color: #4285F4; }
    .actions button { margin-right: 10px; margin-top: 10px; }
    #map { height: 350px; width: 100%; margin-bottom: 20px; border-radius: 8px; }
    ul { padding-left: 18px; }
    .history li { margin-bottom: 4px; }
  </style>
</head>
<body>
  <div class="tracking-card">
    <h2>Acompanhamento do Serviço</h2>
    <div>Status: <span class="status"><%= service.status %></span></div>
    <div id="map"></div>
    <div class="actions">
      <button onclick="alert('Funcionalidade futura: Enviar mensagem!')">Enviar mensagem</button>
      <button onclick="alert('Funcionalidade futura: Finalizar serviço!')">Finalizar serviço</button>
      <button onclick="alert('Funcionalidade futura: Cancelar serviço!')">Cancelar serviço</button>
    </div>
    <h3>Histórico</h3>
    <ul class="history">
      <% service.history.forEach(function(item) { %>
        <li><%= item.time %> - <%= item.event %></li>
      <% }); %>
    </ul>
  </div>

  <script>
    function initMap() {
      const owner = { lat: <%= service.owner.lat %>, lng: <%= service.owner.lng %> };
      const caretaker = { lat: <%= service.caretaker.lat %>, lng: <%= service.caretaker.lng %> };
      const map = new google.maps.Map(document.getElementById('map'), {
        center: owner,
        zoom: 14
      });
      // Ícones personalizados
      const caretakerIcon = {
        url: 'https://cdn-icons-png.flaticon.com/512/616/616408.png',
        scaledSize: new google.maps.Size(40, 40)
      };
      const ownerIcon = {
        url: 'https://cdn-icons-png.flaticon.com/512/1077/1077012.png',
        scaledSize: new google.maps.Size(32, 32)
      };
      // Marcador do dono
      const ownerMarker = new google.maps.Marker({
        position: owner,
        map: map,
        title: '<%= service.owner.name %>',
        icon: ownerIcon
      });
      const ownerInfo = new google.maps.InfoWindow({ content: '<b><%= service.owner.name %></b> (Você)' });
      ownerMarker.addListener('mouseover', () => ownerInfo.open(map, ownerMarker));
      ownerMarker.addListener('mouseout', () => ownerInfo.close());
      // Marcador do cuidador
      const caretakerMarker = new google.maps.Marker({
        position: caretaker,
        map: map,
        title: '<%= service.caretaker.name %>',
        icon: caretakerIcon,
        animation: google.maps.Animation.BOUNCE
      });
      const caretakerInfo = new google.maps.InfoWindow({ content: '<b><%= service.caretaker.name %></b> (Cuidador)' });
      caretakerMarker.addListener('mouseover', () => caretakerInfo.open(map, caretakerMarker));
      caretakerMarker.addListener('mouseout', () => caretakerInfo.close());
      // Traçar rota
      const directionsService = new google.maps.DirectionsService();
      const directionsRenderer = new google.maps.DirectionsRenderer({ map: map, suppressMarkers: true });
      directionsService.route({
        origin: caretaker,
        destination: owner,
        travelMode: google.maps.TravelMode.DRIVING
      }, (result, status) => {
        if (status === 'OK') {
          directionsRenderer.setDirections(result);
        }
      });
    }
  </script>
  <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&callback=initMap"></script>
</body>
</html> 