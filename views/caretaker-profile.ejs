<!DOCTYPE html>
<html>
<head>
  <title>Perfil do Cuidador</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; }
    .profile-card { max-width: 400px; margin: auto; border: 1px solid #ccc; border-radius: 8px; padding: 24px; box-shadow: 0 2px 8px #eee; }
    .profile-card h2 { margin-top: 0; }
    .profile-info { margin-bottom: 16px; }
    .profile-info strong { display: inline-block; width: 120px; }
    .actions button { margin-right: 10px; }
  </style>
</head>
<body>
  <div class="profile-card">
    <h2><%= caretaker.name %></h2>
    <div class="profile-info"><strong>Email:</strong> <%= caretaker.email %></div>
    <div class="profile-info"><strong>Telefone:</strong> <%= caretaker.phone %></div>
    <div class="profile-info"><strong>Especialização:</strong> <%= caretaker.specialization %></div>
    <div class="profile-info"><strong>Certificações:</strong> <%= caretaker.certifications %></div>
    <div class="profile-info"><strong>Disponível:</strong> <%= caretaker.isAvailable ? 'Sim' : 'Não' %></div>
    <div class="actions">
      <button onclick="alert('Funcionalidade futura: Solicitar serviço!')">Solicitar Serviço</button>
      <button onclick="alert('Funcionalidade futura: Enviar mensagem!')">Enviar Mensagem</button>
    </div>
  </div>
</body>
</html> 